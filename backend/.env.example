# ==============================================================================
# Zaykaa Backend Environment Variables
# ==============================================================================
# Copy this file to .env before starting the server in local development:
# cp .env.example .env
# ==============================================================================

# Server Port (Default: 3000)
PORT=3000

# Runtime Environment (development | production | test)
NODE_ENV=development

# JWT Configuration
# Required: Secret key for signing and verifying JSON Web Tokens
JWT_SECRET=zaykaa_super_secret_jwt_key_change_in_production_1234567890
# Token expiration duration (e.g., 24h, 7d, 3600s)
JWT_EXPIRES_IN=24h
